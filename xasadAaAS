<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Tỏ Tình Anh Huy 💖</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background: pink;
      text-align: center;
      padding: 30px;
    }
    .container {
      background: white;
      padding: 20px;
      border-radius: 20px;
      max-width: 600px;
      margin: auto;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    }
    img {
      width: 120px;
      margin: 10px;
    }
    .question {
      font-size: 22px;
      margin: 20px 0;
    }
    .options label {
      display: block;
      background-color: #ff69b4;
      color: white;
      margin: 10px;
      padding: 10px;
      border-radius: 10px;
      cursor: pointer;
    }
    .options input {
      display: none;
    }
    .options input:checked + label {
      background-color: #ff1493;
    }
    .hidden {
      display: none;
    }
    #finalMessage {
      margin-top: 20px;
      font-size: 20px;
      font-weight: bold;
    }
    .submit {
      background-color: #ff69b4;
      padding: 10px 20px;
      color: white;
      font-size: 18px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }
    .submit:hover {
      background-color: #ff1493;
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="https://i.imgur.com/QpkkY1C.png" alt="Heart">
    <img src="https://i.imgur.com/y2dEtrz.png" alt="Boy with ring">

    <form action="#" method="POST" id="quizForm">
      <div class="question">Câu 1: Ai là người đẹp trai nhất trong tim em?</div>
      <div class="options">
        <input type="radio" id="q1a" name="q1" value="A">
        <label for="q1a">A: Bố</label>
        
        <input type="radio" id="q1b" name="q1" value="B">
        <label for="q1b">B: Anh trai</label>

        <input type="radio" id="q1c" name="q1" value="C">
        <label for="q1c">C: Chị gái</label>

        <input type="radio" id="q1d" name="q1" value="D">
        <label for="q1d">D: Anh Huy</label>
      </div>

      <div class="question">Câu 2: Em sẽ lấy ai?</div>
      <div class="options">
        <input type="radio" id="q2a" name="q2" value="A">
        <label for="q2a">A: Anh Huy</label>
        
        <input type="radio" id="q2b" name="q2" value="B">
        <label for="q2b">B: Kai</label>

        <input type="radio" id="q2c" name="q2" value="C">
        <label for="q2c">C: Anh cùng làng</label>

        <input type="radio" id="q2d" name="q2" value="D">
        <label for="q2d">D: Zai 18cm</label>
      </div>

      <div class="question">Câu 3: Đi làm em nhớ ai?</div>
      <div class="options">
        <input type="radio" id="q3a" name="q3" value="A">
        <label for="q3a">A: Bố</label>
        
        <input type="radio" id="q3b" name="q3" value="B">
        <label for="q3b">B: Mẹ</label>

        <input type="radio" id="q3c" name="q3" value="C">
        <label for="q3c">C: Anh Huy</label>

        <input type="radio" id="q3d" name="q3" value="D">
        <label for="q3d">D: 18cm</label>
      </div>

      <div class="question">Câu 4: Cả 4 đáp án đều là ai?</div>
      <div class="options">
        <input type="radio" id="q4a" name="q4" value="A">
        <label for="q4a">A: Anh Huy</label>
        
        <input type="radio" id="q4b" name="q4" value="B">
        <label for="q4b">B: Anh Huy</label>

        <input type="radio" id="q4c" name="q4" value="C">
        <label for="q4c">C: Anh Huy</label>

        <input type="radio" id="q4d" name="q4" value="D">
        <label for="q4d">D: Anh Huy</label>
      </div>

      <div class="question">Câu 5: Điền tên chồng vào đây ❤️</div>
      <div class="options">
        <input type="text" id="husbandInput" placeholder="Ví dụ: anh Huy">
      </div>

      <button type="submit" class="submit">Xác nhận</button>
    </form>

    <div id="finalMessage" class="hidden"></div>
  </div>
  
  <script>
    document.getElementById("quizForm").addEventListener("submit", function(event) {
      event.preventDefault();

      const q1Answer = document.querySelector('input[name="q1"]:checked');
      const q2Answer = document.querySelector('input[name="q2"]:checked');
      const q3Answer = document.querySelector('input[name="q3"]:checked');
      const q4Answer = document.querySelector('input[name="q4"]:checked');
      const husbandInput = document.getElementById("husbandInput").value.trim().toLowerCase();

      let correctAnswers = 0;

      if (q1Answer && q1Answer.value === "D") correctAnswers++;
      if (q2Answer && q2Answer.value === "A") correctAnswers++;
      if (q3Answer && q3Answer.value === "C") correctAnswers++;
      if (q4Answer && q4Answer.value === "A") correctAnswers++;

      if (husbandInput === "a huy" || husbandInput === "anh huy") {
        correctAnswers++;
      }

      const finalMessage = document.getElementById("finalMessage");
      if (correctAnswers === 5) {
        finalMessage.textContent = "🎉 Bạn đã hoàn thành quiz và nhận phần thưởng: Anh Huy 💍!";
        finalMessage.style.color = "green";
      } else {
        finalMessage.textContent = "Bạn đã sai một số câu trả lời, thử lại nhé!";
        finalMessage.style.color = "red";
      }
      finalMessage.classList.remove("hidden");
    });
  </script>
</body>
</html>
